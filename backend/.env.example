# LTISim configuration. Copy to .env and fill in.
# Anything that is a secret lives here and never in the web interface.

# --- Server ---------------------------------------------------------------
PORT=3001
# Bind address. Use 127.0.0.1 when a reverse proxy runs on the same machine.
HOST=127.0.0.1
NODE_ENV=production
# The public HTTPS address people and your LMS reach this installation at.
# LMSs only launch tools over HTTPS.
PUBLIC_URL=https://ltisim.example.edu
# Number of reverse proxies in front of the app (for client IPs).
TRUST_PROXY_HOPS=1

# --- Database (PostgreSQL) -------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ltisim
DB_USER=ltisim
DB_PASSWORD=change-me
# DB_SSL=true            # require TLS to the database
# DB_SSL_CA=/path/ca.pem # CA bundle, if your database needs one
# DB_AUTO_MIGRATE=false  # set to run `npm run db:migrate` yourself

# --- LTI --------------------------------------------------------------------
# Signs session tokens and encrypts the LMS registration. Generate once and
# NEVER change it afterwards, or the LMS registration can no longer be read:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LTI_KEY=generate-a-long-random-value
# Name shown in the LMS.
# TOOL_NAME=LTISim
# How long a launch stays valid before the user must relaunch from the LMS.
# LTI_SESSION_HOURS=24
# 'true' relaxes launch cookie checks. Some browsers block third-party
# cookies inside the LMS frame; turn on only if launches fail without it.
LTI_DEV_MODE=false

# --- Connecting your LMS (one LMS per installation) ------------------------
# Option 1: leave these unset. On first start the server log prints a
# one-time registration link to paste into Canvas or Moodle.
# SETUP_TOKEN=             # fix the token in that link instead of a random one
#
# Option 2: register by hand in your LMS, then describe it here and restart.
# LMS_TYPE=canvas-cloud    # canvas-cloud | canvas-self | moodle
# LMS_URL=https://your-school.instructure.com
# LMS_CLIENT_ID=
# LMS_NAME=Your School
# Only if your LMS differs from the usual endpoints for its type:
# LMS_ISSUER=  LMS_AUTH_ENDPOINT=  LMS_TOKEN_ENDPOINT=  LMS_KEYSET_URL=

# --- Who is an instance administrator --------------------------------------
# By default, administrators of your LMS see the Instance area. To choose
# explicitly instead (recommended on Moodle), list LTI user IDs or emails and
# set INSTANCE_ADMIN_ROLES=false.
# INSTANCE_ADMIN_ROLES=false
# INSTANCE_ADMIN_USER_IDS=
# INSTANCE_ADMIN_EMAILS=

# --- AI provider (bring your own model) ------------------------------------
# Pick ONE provider and give it credentials. Which models are offered, and the
# default conversation and grading models, are then chosen in the web
# interface (Instance > Models).
#
# Anthropic API
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-...
#
# Any OpenAI-compatible API (OpenAI, Azure OpenAI, Ollama, vLLM, LiteLLM, ...)
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1      # e.g. http://localhost:11434/v1
# AI_API_KEY=                                # optional for local servers
# AI_EXTRA_HEADERS={"api-key":"..."}         # e.g. Azure
# AI_MAX_TOKENS_PARAM=max_tokens             # or max_completion_tokens
# AI_TIMEOUT_MS=120000
#
# AWS Bedrock (Anthropic models)
# AI_PROVIDER=bedrock
# AWS_BEDROCK_REGION=us-east-1
# AWS_ACCESS_KEY_ID=        # or leave unset to use the machine's AWS role
# AWS_SECRET_ACCESS_KEY=
AI_PROVIDER=anthropic
AI_API_KEY=

# Optional: set the default models here instead of in the web interface.
# AI_MODEL=
# AI_GRADING_MODEL=

# --- Voice (optional) --------------------------------------------------------
# Voice does not use AI_PROVIDER. With AWS credentials (above, or the machine's
# own), spoken input uses Amazon Transcribe and spoken replies use Amazon Polly.
# Without them, spoken input falls back to the student's browser and there are
# no spoken replies. See docs/Voice.md, including where audio is sent.
# VOICE_SESSION_MAX_SECONDS=1800

# --- Outgoing email (optional) ----------------------------------------------
# Only used for usage-limit alerts. Unset: alerts are not emailed.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# --- Other -------------------------------------------------------------------
# Hosts allowed in embedded learning content (comma-separated).
# LEARNING_CONTENT_IFRAME_HOSTS=
# LOG_VERBOSE=1   # full request logging; contains personal data, debug only
