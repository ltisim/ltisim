{
  "name": "ltisim-backend",
  "version": "1.0.0",
  "description": "LTISim backend: API, LTI endpoints, and static serving of the frontend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "db:migrate": "node src/db/migrate.js",
    "templates:seed": "node src/utils/seed-templates.js",
    "platform:register": "node src/cli/platform.js register",
    "platform:show": "node src/cli/platform.js show",
    "platform:reset": "node src/cli/platform.js reset"
  },
  "keywords": [
    "lti",
    "lti-1.3",
    "canvas",
    "education",
    "simulation"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@aws-sdk/client-bedrock-runtime": "^3.988.0",
    "@aws-sdk/client-polly": "^3.1084.0",
    "@aws-sdk/client-transcribe": "^3.1117.0",
    "@aws-sdk/client-transcribe-streaming": "^3.1117.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "ltijs": "^5.9.2",
    "ltijs-sequelize": "^2.4.4",
    "nodemailer": "^9.0.3",
    "pg": "^8.11.3",
    "sanitize-html": "^2.17.2",
    "sequelize": "^6.37.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true
}
